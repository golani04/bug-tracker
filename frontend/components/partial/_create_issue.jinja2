<!-- {% set current_item = {} if not current_item else current_item %} -->

<div id="create-issue-modal" class="hidden fixed inset-0 z-40 items-center justify-center bg-black/50">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-lg mx-4">
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200">
            <h5 class="text-lg font-semibold">Create Issue</h5>
            <button type="button" data-modal-dismiss class="text-gray-400 hover:text-gray-600" aria-label="Close">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <form action="/api/v1/issues{{ '/' + (current_item.id|string) if current_item else ''}}"
            id="create-issue-form" method="post">
            <input type="hidden" name="reporter" value="1">
            <input type="hidden" name="id" value="{{ current_item.id }}">

            <div class="px-5 py-4 space-y-4">
                <div>
                    <label for="issue-title" class="block text-sm font-medium mb-1">Title:</label>
                    <input type="text" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                        name="title" id="issue-title" value="{{ current_item.title }}">
                </div>
                <div>
                    <label for="issue-description" class="block text-sm font-medium mb-1">Description:</label>
                    <textarea class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                        name="description" id="issue-description" style="min-height: 4em;">{{ current_item.description }}</textarea>
                </div>
                <div class="flex flex-wrap gap-4">
                    {% for key, items in [('severity', severity), ('status', status), ('label', label)] %}
                    <div>
                        <label for="issue-{{ key }}" class="block text-sm font-medium mb-1">{{ key | title }}:</label>
                        <select class="rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                            name="{{ key }}" id="issue-{{ key }}">
                            {% for item in items %}
                            {% if current_item.get(key)==item.value %}
                            <option value="{{ item.value }}" selected>
                                {% else %}
                            <option value="{{ item.value }}">
                                {% endif %}

                                {{ item.name | replace('_', ' ') | title }}
                            </option>
                            {% endfor %}
                        </select>
                    </div>
                    {% endfor %}
                </div>
                <div>
                    <label for="issue-due" class="block text-sm font-medium mb-1">Due:</label>
                    <input type="date" class="rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                        name="due" id="issue-due" value="{{ current_item.due or '' }}">
                </div>
            </div>
            <div class="flex justify-end gap-2 px-5 py-4 border-t border-gray-200">
                <button type="button" data-modal-dismiss
                    class="rounded-md px-4 py-2 text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200">Close</button>
                <button type="submit"
                    class="rounded-md px-4 py-2 text-sm font-medium bg-blue-600 text-white hover:bg-blue-500">Save changes</button>
            </div>
        </form>
    </div>
</div>

<div id="delete-issue-modal" class="hidden fixed inset-0 z-40 items-center justify-center bg-black/50">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-lg mx-4">
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200">
            <h5 class="text-lg font-semibold">{{ current_item.title }}</h5>
            <button type="button" data-modal-dismiss class="text-gray-400 hover:text-gray-600" aria-label="Close">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <form action="/api/v1/issues/{{ current_item.id }}/delete" id="delete-issue-form" method="post">
            <div class="px-5 py-4">
                <p>Are sure you want to remove this issue.</p>
            </div>
            <div class="flex justify-end gap-2 px-5 py-4 border-t border-gray-200">
                <button type="button" data-modal-dismiss
                    class="rounded-md px-4 py-2 text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200">Close</button>
                <button type="submit"
                    class="rounded-md px-4 py-2 text-sm font-medium bg-red-600 text-white hover:bg-red-500">Yes, delete</button>
            </div>
        </form>
    </div>
</div>
